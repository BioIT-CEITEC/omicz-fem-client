# Configuration docker-compose.yml reads. Copy it once:
#
#   cp .env.example .env
#
# The copy works as it stands against an omicz-wes compose stack on the same host — the
# WES API and the result service are reached by service name over the `omicz-wes-edge`
# network — except for the four broker lines, which are this node's identity on the
# orchestrator's RabbitMQ and cannot have a useful default. .env is gitignored, so the
# password you put there stays out of the repository.

# --- Node identity and the orchestrator's broker -----------------------------------
# The node name is also the queue this client consumes, and the PEM filenames in
# config/rabbitmq-certificates/ embed it.
FEM_NODE_NAME=CZE
FEM_RABBIT_HOST=fl.bsc.es
FEM_RABBIT_PORT=5671
FEM_RABBIT_VHOST=gdi_server
FEM_RABBIT_USER=CZErmq
# No default: the orchestrator issues this.
FEM_RABBIT_PASSWORD=
# TLS with a client certificate; the PEMs go in config/rabbitmq-certificates/.
FEM_SSL_ACTIVE=true
# Passphrase on the client key; leave empty if it is unencrypted.
FEM_CERT_PHRASE=
# The FEM orchestrator's API, not the WES.
FEM_API_BASE_URL=https://fl.bsc.es/dt4h-fem/API/v1

# --- WES API and result service ----------------------------------------------------
# Service names on FEM_NETWORK below. The WES API serves /runs and /service-info at the
# root — no /ga4gh/wes/v1 prefix.
WES_URL=http://wes:8000
RESULTS_URL=http://results:8000

# Renames a deliverable on the way back to the orchestrator: glob over the archive path
# the workflow wrote, to the name the federation expects. {node} is FEM_NODE_NAME, so
# compute3's federated_results/round_0_counts.csv is delivered as CZE_goe-counts.CZE.csv.
FEM_RESULT_NAMES={"*_counts.csv": "goe-counts.{node}.csv"}

# --- Container ---------------------------------------------------------------------
# Built from k8s/Dockerfile; `pull_policy: missing` uses a local build if there is one.
FEM_IMAGE=krkoo/fem-client:dev # PRODUCTION: pin a digest or a version tag, not :dev
FEM_PULL_POLICY=missing
FEM_CONTAINER_NAME=fem-client

# The network the omicz-wes compose stack creates. Both `wes` and `results` are on it and
# it has a gateway, so the broker is reachable too. With the WES API on another host, set
# this to a network you have (`bridge`) and point WES_URL / RESULTS_URL at it.
FEM_NETWORK=omicz-wes-edge

# /app/config: config.py, launcher.json, wes-catalogue.json, rabbitmq-certificates/.
# Gitignored — it is this node's site configuration, not repository content.
FEM_CONFIG_DIR=./config

# Named volumes by default. Replace either with a host path to look inside without
# `docker cp` — the image runs as uid 1000, so that path must be writable by it.
FEM_SANDBOX_DIR=fem-sandbox
FEM_LOG_DIR=fem-logs

# /tmp in the container: `send_files` spools a run's result archive there before
# unpacking it, so it must fit the largest archive this node produces.
FEM_TMPFS_SIZE=2g

# --- Paths the catalogue hands the workflow ----------------------------------------
# As the WES workers see it, not as this container does. There is no data path: the
# datasets are addressed by id and the WES stages them itself. A site whose catalogue
# injects %DATA% sets FEM_DATA_REMOTE_PATH here.
FEM_SANDBOX_REMOTE_PATH=/sandbox
